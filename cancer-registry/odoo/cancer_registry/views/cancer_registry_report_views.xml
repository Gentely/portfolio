<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         مشاكل الجودة — عرض مركزي لكل السجلات
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_qc_issue_tree" model="ir.ui.view">
        <field name="name">cancer.registry.qc.issue.tree</field>
        <field name="model">cancer.registry.qc.issue</field>
        <field name="arch" type="xml">
            <tree string="مشاكل جودة البيانات" create="false" multi_edit="1" sample="1"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="resolved == True">
                <field name="case_id"/>
                <field name="code"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'error'"
                       decoration-warning="severity == 'warning'"
                       decoration-info="severity == 'info'"/>
                <field name="rule_family" optional="show"/>
                <field name="rule_name" optional="show"/>
                <field name="field_label"/>
                <field name="message"/>
                <field name="fix" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="resolved" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_qc_issue_search" model="ir.ui.view">
        <field name="name">cancer.registry.qc.issue.search</field>
        <field name="model">cancer.registry.qc.issue</field>
        <field name="arch" type="xml">
            <search string="بحث في مشاكل الجودة">
                <field name="case_id"/>
                <field name="code"/>
                <field name="message"/>
                <field name="field_label"/>
                <separator/>
                <filter string="أخطاء فقط" name="errors" domain="[('severity','=','error')]"/>
                <filter string="تحذيرات" name="warnings" domain="[('severity','=','warning')]"/>
                <filter string="غير معالجة" name="open" domain="[('resolved','=',False)]"/>
                <filter string="معالجة" name="closed" domain="[('resolved','=',True)]"/>
                <separator/>
                <filter string="الاكتمال (A)" name="fam_a" domain="[('code','=like','Q-A%')]"/>
                <filter string="الصيغة والمعايير (B)" name="fam_b" domain="[('code','=like','Q-B%')]"/>
                <filter string="المنطق والتسلسل (C)" name="fam_c" domain="[('code','=like','Q-C%')]"/>
                <filter string="التكرار (D)" name="fam_d" domain="[('code','=like','Q-D%')]"/>
                <filter string="المستندات (E)" name="fam_e" domain="[('code','=like','Q-E%')]"/>
                <filter string="الأسماء (F)" name="fam_f" domain="[('code','=like','Q-F%')]"/>
                <group expand="1" string="تجميع حسب">
                    <filter string="القاعدة" name="group_code" context="{'group_by':'code'}"/>
                    <filter string="العائلة" name="group_family" context="{'group_by':'rule_family'}"/>
                    <filter string="الخطورة" name="group_sev" context="{'group_by':'severity'}"/>
                    <filter string="الحقل" name="group_field" context="{'group_by':'field_label'}"/>
                    <filter string="السجل" name="group_case" context="{'group_by':'case_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_qc_issue_pivot" model="ir.ui.view">
        <field name="name">cancer.registry.qc.issue.pivot</field>
        <field name="model">cancer.registry.qc.issue</field>
        <field name="arch" type="xml">
            <pivot string="تحليل مشاكل الجودة" disable_linking="True">
                <field name="rule_family" type="row"/>
                <field name="code" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_qc_issue_graph" model="ir.ui.view">
        <field name="name">cancer.registry.qc.issue.graph</field>
        <field name="model">cancer.registry.qc.issue</field>
        <field name="arch" type="xml">
            <graph string="أكثر القواعد تكراراً" type="bar" sample="1">
                <field name="code"/>
            </graph>
        </field>
    </record>

    <record id="action_qc_issues" model="ir.actions.act_window">
        <field name="name">مشاكل الجودة</field>
        <field name="res_model">cancer.registry.qc.issue</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_qc_issue_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_errors': 1,
                               'search_default_group_code': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد مشاكل جودة مفتوحة 🎉</p>
            <p>شغّل «فحص جودة البيانات» من السجلات لتعبئة هذه القائمة.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         لوحات تحليلية جاهزة
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_analysis_by_site" model="ir.actions.act_window">
        <field name="name">حسب الموقع الأولي</field>
        <field name="res_model">cancer.registry.case</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="context">{'group_by': ['primary_site_label'],
                               'search_default_validated': 0}</field>
        <field name="view_id" ref="view_cancer_case_graph"/>
    </record>

    <record id="action_analysis_by_district" model="ir.actions.act_window">
        <field name="name">حسب البلدية</field>
        <field name="res_model">cancer.registry.case</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'group_by': ['district']}</field>
        <field name="view_id" ref="view_cancer_case_pivot"/>
    </record>

    <record id="action_analysis_by_year" model="ir.actions.act_window">
        <field name="name">حسب سنة التشخيص</field>
        <field name="res_model">cancer.registry.case</field>
        <field name="view_mode">graph,pivot,calendar,tree</field>
        <field name="context">{'group_by': ['diagnosis_year']}</field>
        <field name="view_id" ref="view_cancer_case_graph"/>
    </record>

    <record id="action_analysis_by_stage" model="ir.actions.act_window">
        <field name="name">حسب المرحلة عند التشخيص</field>
        <field name="res_model">cancer.registry.case</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'group_by': ['summary_stage', 'primary_site_label']}</field>
        <field name="view_id" ref="view_cancer_case_pivot"/>
    </record>

    <record id="action_analysis_survival" model="ir.actions.act_window">
        <field name="name">المآل والبقاء</field>
        <field name="res_model">cancer.registry.case</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'group_by': ['vitality_status', 'diagnosis_year']}</field>
        <field name="view_id" ref="view_cancer_case_pivot"/>
    </record>

</odoo>
