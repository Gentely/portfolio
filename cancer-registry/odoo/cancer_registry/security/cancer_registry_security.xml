<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         مجموعة التطبيقات الخاصة بالسجل
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="module_category_cancer_registry" model="ir.module.category">
        <field name="name">السجل القومي للسرطان</field>
        <field name="description">صلاحيات مكتب سجل السرطان</field>
        <field name="sequence">25</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         المستويات
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="group_registry_user" model="res.groups">
        <field name="name">مُدخِل بيانات السجل</field>
        <field name="category_id" ref="module_category_cancer_registry"/>
        <field name="comment">
يحق له رفع المستندات، تشغيل الاستخراج الآلي وفحص الجودة، وإدخال/تعديل السجلات.
لا يستطيع حذف سجل معتمَد ولا تعديل الجداول المرجعية (ICD-O-3).
        </field>
    </record>

    <record id="group_registry_manager" model="res.groups">
        <field name="name">مدير السجل</field>
        <field name="category_id" ref="module_category_cancer_registry"/>
        <field name="implied_ids" eval="[(4, ref('group_registry_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">
صلاحيات كاملة: اعتماد السجلات، الحذف، التصدير الجماعي للأرشيف الوطني،
والوصول إلى كل الجهات (تجاوز قاعدة نطاق الجهة).
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         قواعد السجلات (Record Rules)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- السجلات مرتبطة بجهة (شركة) — المُدخِل يرى جهته فقط، المدير يرى الكل -->
    <record id="rule_case_company" model="ir.rule">
        <field name="name">سجل السرطان: نطاق الجهة</field>
        <field name="model_id" ref="model_cancer_registry_case"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_registry_user'))]"/>
    </record>

    <record id="rule_case_company_manager" model="ir.rule">
        <field name="name">سجل السرطان: كل الجهات (مدير)</field>
        <field name="model_id" ref="model_cancer_registry_case"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_registry_manager'))]"/>
    </record>

    <!-- المستندات وسطور العلاج ومشاكل الجودة تتبع سجلها الأب -->
    <record id="rule_document_company" model="ir.rule">
        <field name="name">مستند السجل: نطاق الجهة</field>
        <field name="model_id" ref="model_cancer_registry_document"/>
        <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_registry_user'))]"/>
    </record>

    <record id="rule_treatment_company" model="ir.rule">
        <field name="name">سطر العلاج: نطاق الجهة</field>
        <field name="model_id" ref="model_cancer_registry_treatment"/>
        <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_registry_user'))]"/>
    </record>

    <record id="rule_qc_issue_company" model="ir.rule">
        <field name="name">مشكلة الجودة: نطاق الجهة</field>
        <field name="model_id" ref="model_cancer_registry_qc_issue"/>
        <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_registry_user'))]"/>
    </record>

    <!-- الجداول المرجعية ICD-O-3 عامة للقراءة -->
    <record id="rule_refdata_global" model="ir.rule">
        <field name="name">ICD-O-3: قراءة عامة</field>
        <field name="model_id" ref="model_cancer_registry_icdo3_topography"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
